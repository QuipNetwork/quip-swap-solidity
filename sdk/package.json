{
  "name": "@quip.network/quip-swap-sdk",
  "version": "0.1.0-beta.2",
  "description": "TypeScript SDK for the Quip Swap protocol",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:abi": "bun run scripts/generate-abi.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/run-test-files.ts test/unit test/mocked-client",
    "test:unit": "bun run scripts/run-test-files.ts test/unit",
    "test:mocked": "bun run scripts/run-test-files.ts test/mocked-client",
    "test:integration": "bun run scripts/run-integration-tests.ts",
    "test:integration:verbose": "bun run scripts/run-integration-tests.ts --reporter=verbose",
    "test:cross-chain": "bun run scripts/run-cross-chain-tests.ts",
    "demo:full": "bun run scripts/run-full-demo.ts",
    "smoke": "bun run scripts/smoke.ts",
    "build": "tsup",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  }
}
