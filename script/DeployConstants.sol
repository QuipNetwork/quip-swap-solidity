pragma solidity ^0.8.33;

/**
 * @title DeployConstants
 * @dev Every value that decides WHAT gets deployed WHERE, compiled in.
 *
 *      THE REGISTRY DERIVES FROM THIS FILE, not the other way round.
 *      `sdk/src/deployments.json` is generated by `make sync-registry` from
 *      these constants (address = f(CreateX, DEPLOYER, label), so every field
 *      but liveness is derivable), and a CI test re-derives it to prove the
 *      committed file was not hand-edited. Editing the JSON is not how you
 *      change a deployment; editing this file is.
 *
 *      WHY COMPILED IN RATHER THAN ENV. A wrong label does not revert. It
 *      derives a different salt, deploys successfully, and lands at an
 *      unadvertised address — the same silent-success failure that put the
 *      wrong WalletFactory into two testnet deployments. A constant here cannot
 *      be stale at runtime: changing it is a source edit that shows up in the
 *      diff and in review, which is the same property that makes
 *      `Constants.DEPLOYER` safe.
 *
 *      TWO LABEL FAMILIES. All mainnets share MAINNET_LABEL, all testnets share
 *      TESTNET_LABEL — so each family has ONE address across its chains. That
 *      only stays true if a family is redeployed as a batch: bumping
 *      TESTNET_LABEL moves the address on every testnet, and deploying only
 *      some of them leaves the family split across two addresses. The registry
 *      consistency test is what makes a half-finished migration visible.
 */
library DeployConstants {
  /// @notice The quip WalletFactory proxy the Omnibus wallet route trusts.
  ///
  /// @dev ONE constant for both families: this proxy is deployed at the same
  ///      address, over the same implementation, with the same owner, on Base
  ///      mainnet, Base Sepolia and OP Sepolia. Splitting it per family would
  ///      be two things that can drift, and drift here is exactly what broke
  ///      the wallet route — 0x6de121F7cc8b310aDBc957425B97e1C8dfcE3BE5 is a
  ///      real, working factory proxy that passes every liveness check and is
  ///      simply the WRONG one. The only defence is that this value is stated
  ///      once, compiled in, and asserted against the deployed immutable.
  address internal constant WALLET_FACTORY = 0xdCD90563B912f82D2f23d5c7988B3Fec2da63471;

  /// @notice Salt version label for MAINNET deployments.
  /// @dev Bumping this abandons the current mainnet address and deploys a new
  ///      Omnibus at a new one. There is no migration path for state; treat a
  ///      bump as a new deployment, not an upgrade.
  string internal constant MAINNET_LABEL = 'QUIP:Omnibus:v1.0.0-beta.2';

  /// @notice Salt version label for TESTNET deployments.
  /// @dev Expected to churn far more often than the mainnet label. Bump it,
  ///      then redeploy every chain in TESTNET_CHAINS in one batch.
  string internal constant TESTNET_LABEL = 'QUIP:Omnibus:v1.0.0-beta.2';

  /// @notice Chains the MAINNET label deploys to.
  /// @dev Doubles as the deploy script's allowlist: a mainnet deploy pointed at
  ///      an RPC outside this set aborts before broadcasting, which is the
  ///      failure a split script alone does not prevent.
  function mainnetChains() internal pure returns (uint256[] memory chains) {
    chains = new uint256[](1);
    chains[0] = 8453; // Base
  }

  /// @notice Chains the TESTNET label deploys to.
  function testnetChains() internal pure returns (uint256[] memory chains) {
    chains = new uint256[](2);
    chains[0] = 84_532; // Base Sepolia
    chains[1] = 11_155_420; // OP Sepolia
  }

  /// @notice Whether `chainId` is a mainnet target.
  function isMainnet(uint256 chainId) internal pure returns (bool) {
    return _contains(mainnetChains(), chainId);
  }

  /// @notice Whether `chainId` is a testnet target.
  function isTestnet(uint256 chainId) internal pure returns (bool) {
    return _contains(testnetChains(), chainId);
  }

  /// @notice The label a given chain deploys under.
  /// @dev Reverts for an unlisted chain rather than defaulting to either
  ///      family — a chain nobody declared must never silently inherit the
  ///      mainnet label.
  function labelFor(uint256 chainId) internal pure returns (string memory) {
    if (isMainnet(chainId)) return MAINNET_LABEL;
    if (isTestnet(chainId)) return TESTNET_LABEL;
    revert('DeployConstants: chain id is in neither the mainnet nor the testnet set');
  }

  /// @notice The version label as the right-padded ASCII word the Omnibus
  ///         stores in its VERSION immutable.
  /// @dev Derived from the SAME string the salt entropy hashes, so the on-chain
  ///      VERSION and the address can never describe different labels.
  function versionWord(string memory label) internal pure returns (bytes32 word) {
    bytes memory raw = bytes(label);
    require(raw.length > 0, 'DeployConstants: version label is empty');
    require(raw.length <= 32, 'DeployConstants: version label exceeds 32 bytes');

    assembly {
      word := mload(add(raw, 32))
    }
    // mload reads a full word; anything past the label's length is whatever
    // happened to sit next to it in memory. Mask it off.
    word = bytes32(uint256(word) & (type(uint256).max << (256 - raw.length * 8)));
  }

  function _contains(uint256[] memory haystack, uint256 needle) private pure returns (bool) {
    for (uint256 i; i < haystack.length; i++) {
      if (haystack[i] == needle) return true;
    }
    return false;
  }
}
