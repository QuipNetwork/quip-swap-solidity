# ==============================================================================
# Quip Swap Deployment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values before deploying.
# Run: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Deployer Configuration
# ------------------------------------------------------------------------------
# Broadcasting account (pays gas; NOT part of the deployed address). The REAL
# key goes in the gitignored .env, NEVER here. For LOCAL testing you may use a
# well-known Anvil dev key — PUBLIC, not a secret. This is Anvil account #0; do
# NOT use it (or any key in this file) anywhere real.
DEPLOYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Address of the broadcasting account above (the EOA that signs/sends the txs).
SENDER=

# Deployer CONTRACT address (IDeployer, solady CREATE3) — NOT the broadcasting
# EOA. Omnibus is deployed through this contract, so the deployed address is a
# function of (Deployer, salt) only: identical for any broadcaster on every
# chain. Public, not a secret. The contract must already exist on the target
# chain (the deploy script reverts if it has no code). Required.
DEPLOYER_ADDRESS=0xA1A3990Ea898123e4B107D0A2f614232bE428Ef1

# Initial owner baked into the Omnibus constructor (public, not a secret).
# Sets who controls the deployed contract; does NOT affect the deployed CREATE3
# address (which ignores init code). Required (must be non-zero).
OMNIBUS_OWNER=

# QuipFactory address wired into the Omnibus constructor (public, not a secret).
# The Omnibus constructor reverts ZeroQuipFactory if this is the zero address,
# so a deploy requires a real factory here. Does NOT affect the CREATE3 address
# (init code is ignored for addressing), only what the deployed contract is
# wired to. Required (must be non-zero).
QUIP_FACTORY=

# ------------------------------------------------------------------------------
# QuipPortal Configuration
# ------------------------------------------------------------------------------
# Admin address - can update fees and withdraw accumulated fees
PORTAL_ADMIN=

# Maximum fee that can ever be set (immutable after deployment)
# 0.01 ETH = 10000000000000000 wei
PORTAL_MAX_FEE=10000000000000000

# Initial creation fee charged per swap deployment
# 0.00000001 ETH = 10000000000 wei
PORTAL_CREATION_FEE=10000000000

# ------------------------------------------------------------------------------
# RPC URLs
# ------------------------------------------------------------------------------
# One API_URL_<CHAIN> per network (BASE, SEPOLIA, OPTIMISM, MAINNET, DEGEN, …).
# Add the chains you actually deploy to; the rest can be omitted.
API_URL_BASE_SEPOLIA=https://sepolia.base.org

# ------------------------------------------------------------------------------
# Block Explorer API Keys (for contract verification)
# ------------------------------------------------------------------------------
# Etherscan v2 multichain key (works across Etherscan-family explorers).
ETHERSCAN_API_KEY=
# Separate key for the Degen chain explorer.
ETHERSCAN_API_KEY_DEGEN=
