# ==============================================================================
# Quip Swap Deployment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values before deploying.
# Run: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Deployer Configuration
# ------------------------------------------------------------------------------
# Broadcasting account (pays gas). The CreateX salt is permissioned to this
# EOA, so it IS part of the deployed address: the Omnibus address is a function
# of (CreateX, this EOA, salt). The REAL key goes in the gitignored .env, NEVER
# here. For LOCAL testing you may use a well-known Anvil dev key — PUBLIC, not
# a secret. This is Anvil account #0; do NOT use it (or any key in this file)
# anywhere real.
DEPLOYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Address of the broadcasting EOA above (public, not a secret). NOT read by the
# deploy script (it derives the EOA from DEPLOYER_PK); used by VerifyOmnibus
# and ActivateVerifier to predict the Omnibus address offline. Must match
# DEPLOYER_PK. The value below is Anvil account #0.
DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Current v1.1 deployment (see script/DEPLOYMENT.md).
PROTOCOL_OWNER=
TRUSTED_VERIFIER=
# Positive seconds; review all supported routes. No production default.
FINAL_CLAIM_DELAY=

# Initial owner baked into the Omnibus constructor (public, not a secret).
# Sets who controls the deployed contract; does NOT affect the deployed CREATE3
# address (which ignores init code). Required (must be non-zero).
OMNIBUS_OWNER=

# The quip WalletFactory proxy on the target chain, baked into the Omnibus
# constructor as an immutable (public, not a secret). Gates the wallet commit
# route: an empty-signature commit requires vaultIdOf(msg.sender) != 0 on this
# factory. Does NOT affect the deployed CREATE3 address. Required (must be
# non-zero).
WALLET_FACTORY=

# ------------------------------------------------------------------------------
# Verifier Activation (post-deploy owner action:
#   make activate-verifier RPC=... VERIFIER=0x...
# The verifier is a command-line ARGUMENT, not env; the Omnibus address is
# predicted from (CreateX, DEPLOYER_ADDRESS, salt), never passed in.)
# ------------------------------------------------------------------------------
# Private key of the Omnibus OWNER (setVerifierActivity is onlyOwner). May
# equal DEPLOYER_PK only if OMNIBUS_OWNER was set to the deployer EOA. Real key
# in .env only, never here.
OMNIBUS_OWNER_PK=

# ------------------------------------------------------------------------------
# RPC URLs
# ------------------------------------------------------------------------------
# One API_URL_<CHAIN> per network (BASE, SEPOLIA, OPTIMISM, MAINNET, DEGEN, …).
# Add the chains you actually deploy to; the rest can be omitted.
API_URL_BASE_SEPOLIA=https://sepolia.base.org
API_URL_OP_SEPOLIA=https://sepolia.optimism.io

# ------------------------------------------------------------------------------
# Block Explorer API Keys (for contract verification)
# ------------------------------------------------------------------------------
# Etherscan v2 multichain key (works across Etherscan-family explorers).
ETHERSCAN_API_KEY=
# Separate key for the Degen chain explorer.
ETHERSCAN_API_KEY_DEGEN=
