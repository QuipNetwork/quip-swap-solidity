# ==============================================================================
# Quip Swap Deployment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values before deploying.
# Run: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Deployer Configuration
# ------------------------------------------------------------------------------
# Private key of the deployer account. The REAL key goes in the gitignored .env,
# NEVER here. For LOCAL testing (predict -> deploy -> verify against Anvil) you
# may use a well-known Anvil dev key — PUBLIC, not a secret. This is Anvil
# account #0; do NOT use it (or any key in this file) anywhere real.
DEPLOYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Initial owner baked into the Omnibus constructor (public, not a secret).
# Sets who controls the deployed contract; does NOT affect the deployed CREATE3
# address (which ignores init code). Used by deploy/verify tooling.
OMNIBUS_OWNER=0x0000000000000000000000000000000000000000

# QuipFactory address wired into the Omnibus constructor (public, not a secret).
# Per-chain: the QuipFactory deployed on the target chain. The Omnibus
# constructor reverts ZeroQuipFactory if this is the zero address, so a REAL
# deploy requires a real factory here. For local testing you may deploy/point at
# a mock factory. Does NOT affect the CREATE3 address (init code is ignored for
# addressing), only what the deployed contract is wired to.
QUIP_FACTORY=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# QuipPortal Configuration
# ------------------------------------------------------------------------------
# Admin address - can update fees and withdraw accumulated fees
PORTAL_ADMIN=

# Maximum fee that can ever be set (immutable after deployment)
# 0.01 ETH = 10000000000000000 wei
PORTAL_MAX_FEE=10000000000000000

# Initial creation fee charged per swap deployment
# 0.0001 ETH = 100000000000000 wei
PORTAL_CREATION_FEE=100000000000000

# ------------------------------------------------------------------------------
# RPC URLs
# ------------------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ------------------------------------------------------------------------------
# Block Explorer API Keys (for contract verification)
# ------------------------------------------------------------------------------
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=
